---
import MainLayout from "@/layouts/MainLayout.astro";
import Starfield from "@/components/Starfield.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getCollection, render } from "astro:content";
import "@/styles/global.css";

const { slug } = Astro.params;

const projects = await getCollection("projects");
const project = projects.find((p) => p.slug === slug);

if (!project) {
  return Astro.rewrite("/404");
}

const { Content } = await render(project);
const { title, description, category, tags, url, github, image } = project.data;
---

<MainLayout title={`${title} - mulek.cc`} description={description} image={image} type="article">
  <Starfield />
  <Header />

  <div class="relative z-20 min-h-screen">
    <article class="container mx-auto px-4 pt-16 pb-8 max-w-4xl">
      <div class="text-center pb-8 border-b border-neutral-200 dark:border-neutral-700">
        <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-secondary/20 dark:bg-secondary/30 text-secondary border border-secondary/50">
          {category}
        </span>

        <h1 class="mt-4 text-3xl font-extrabold text-neutral-800 dark:text-neutral-200 sm:text-5xl">
          {title}
        </h1>
        <p class="text-lg text-neutral-600 dark:text-neutral-400 mt-4 max-w-2xl mx-auto">
          {description}
        </p>

        <div class="flex flex-wrap justify-center gap-2 mt-6">
          {tags.map((tag) => (
            <span class="text-xs font-medium px-3 py-1 rounded-full bg-accent/20 dark:bg-accent/30 text-accent border border-accent/50">
              {tag}
            </span>
          ))}
        </div>

        {(url || github) && (
          <div class="flex flex-wrap justify-center gap-4 mt-8">
            {url && (
              <a href={url} target="_blank" rel="noopener noreferrer" class="px-6 py-2 bg-accent text-white font-semibold rounded-lg hover:bg-accent/90 transition">
                View Live
              </a>
            )}
            {github && (
              <a href={github} target="_blank" rel="noopener noreferrer" class="px-6 py-2 border border-accent text-accent font-semibold rounded-lg hover:bg-accent/10 transition">
                GitHub
              </a>
            )}
          </div>
        )}
      </div>

      <div class="prose dark:prose-invert max-w-prose mx-auto lg:prose-lg mt-12">
        <Content />
      </div>

      <div class="text-center mt-16">
        <a href="/projects" class="text-accent hover:underline font-semibold">&larr; Back to Projects</a>
      </div>
    </article>
  </div>

  <Footer />
</MainLayout>
