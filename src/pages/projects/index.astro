---
// src/pages/projects/index.astro
import MainLayout from "@/layouts/MainLayout.astro";
import Starfield from "@/components/Starfield.astro";
import { pageSky } from "@/config/sky";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

import ProjectTile from "@/components/ProjectTile.astro";
import { getCollection } from "astro:content";
import { projectCategories as categories } from "@/content/config";

import "@/styles/global.css";

// Projects live in src/content/projects; group by category, newest first within each. The current
// project (current: true) comes first, as a wide featured card.
const projects = (await getCollection("projects")).sort(
    (a, b) =>
        Number(!!b.data.current) - Number(!!a.data.current) ||
        categories.indexOf(a.data.category) - categories.indexOf(b.data.category) ||
        b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const filters = [
    { name: "All", count: projects.length },
    ...categories.map((name) => ({ name, count: projects.filter((p) => p.data.category === name).length })),
];
---

<MainLayout title="Projects - mulek.cc" description="Projects by Michael Scott Mulek - web development, homelab infrastructure, and game servers.">
    <Starfield {...pageSky} />
    <Header />

    <div id="projects-container" class="page-main">
        <div class="container mx-auto px-4 max-w-6xl">
            <h1 class="page-title mb-8">
                Project Archive
            </h1>

            <!-- Filters: the selected one is filled, the rest outlined; each shows how many projects it has -->
            <div id="filter-menu" class="flex flex-wrap justify-center gap-2 mb-8" role="group" aria-label="Filter projects">
                {filters.map(({ name, count }) => (
                    <button
                        type="button"
                        data-category={name}
                        aria-pressed={name === "All" ? "true" : "false"}
                        class="filter-btn inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-accent/60 text-sm font-semibold text-accent
                            hover:border-highlight hover:text-highlight transition-colors
                            aria-pressed:bg-accent aria-pressed:border-accent aria-pressed:text-on-accent"
                    >
                        {name}
                        <span class="font-mono text-xs opacity-70">{count}</span>
                    </button>
                ))}
            </div>

            <!-- Height is locked to the full list so filtering doesn't make the centered page jump -->
            <div id="project-results">
            <div id="project-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {projects.map(({ slug, data }) => (
                    <ProjectTile {...data} slug={`/projects/${slug}`} featured={!!data.current} />
                ))}
            </div>

            <div id="empty-state" class="text-center py-10 text-neutral-600 dark:text-neutral-400 hidden">
                No projects match the current filter.
            </div>
            </div>
        </div>
    </div>

    <Footer />
</MainLayout>

<script>
    document.addEventListener('astro:page-load', () => {
        const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
        const projectCards = document.querySelectorAll<HTMLElement>('.project-card');
        const emptyState = document.getElementById('empty-state');
        const results = document.getElementById('project-results');
        if (!filterButtons.length) return;
        let currentCategory = 'All';

        function filterProjects(category: string) {
            let matches = 0;
            projectCards.forEach((card) => {
                const show = category === 'All' || card.dataset.category === category;
                card.style.display = show ? '' : 'none';
                if (show) matches++;
            });
            if (emptyState) emptyState.style.display = matches === 0 ? 'block' : 'none';
        }

        // Lock the results area to its height with every card showing, so the page
        // (centered vertically on tall screens) doesn't shift when a filter hides cards
        function lockResultsHeight() {
            if (!results) return;
            results.style.minHeight = '';
            filterProjects('All');
            results.style.minHeight = `${results.offsetHeight}px`;
            filterProjects(currentCategory);
        }

        // The card layout changes with the window width, so re-measure on resize.
        // Removed before the next page swap so listeners don't pile up across navigations.
        window.addEventListener('resize', lockResultsHeight);
        document.addEventListener('astro:before-swap', () => {
            window.removeEventListener('resize', lockResultsHeight);
        }, { once: true });

        filterButtons.forEach((button) => {
            button.addEventListener('click', () => {
                currentCategory = button.dataset.category ?? 'All';
                filterButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
                filterProjects(currentCategory);
            });
        });

        lockResultsHeight();
    });
</script>
