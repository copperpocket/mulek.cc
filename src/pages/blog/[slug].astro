---
import BlogPostLayout from "@/layouts/BlogPostLayout.astro";
import { getCollection, render } from "astro:content";

const { slug } = Astro.params;

// Old URLs used the file name (/blog/post.md); send them to the clean slug
if (slug?.endsWith(".md")) {
  return Astro.redirect(`/blog/${slug.slice(0, -3)}`, 301);
}

const posts = await getCollection("blog");
const post = posts.find((p) => p.slug === slug);

if (!post) {
  // Project write-ups used to live in the blog
  const projects = await getCollection("projects");
  if (projects.some((p) => p.slug === slug)) {
    return Astro.redirect(`/projects/${slug}`, 301);
  }
  return Astro.rewrite("/404");
}

const { Content } = await render(post);
const data = post.data;
---

<BlogPostLayout data={data}>
  <Content />
</BlogPostLayout>
