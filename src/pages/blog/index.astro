---
import MainLayout from "@/layouts/MainLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Starfield from "@/components/Starfield.astro";
import { pageSky } from "@/config/sky";
import "@/styles/global.css";

import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");

// Sort posts by newest first
allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const pageTitle = "Blog Archive";
---

<MainLayout title={`Blog - mulek.cc`} description="Articles on homelab infrastructure, self-hosting, and development by Michael Scott Mulek.">
  <Starfield {...pageSky} />
  <Header />

  <div class="page-main">
    <div class="container mx-auto px-4">
      <section class="max-w-3xl mx-auto">
        <h1 class="text-3xl font-bold text-center mb-8 text-neutral-800 dark:text-neutral-200">
          {pageTitle}
        </h1>

        {allPosts.length > 0 ? (
          <ul role="list" class="space-y-6">
            {allPosts.map(({ slug, data }) => (
              <li
                class="post-preview card-edge card-lift hover:scale-[1.01] bg-white dark:bg-neutral-900 rounded-xl shadow-xl p-6"
              >
                <a href={`/blog/${slug}`} class="block">
                  <h2 class="text-xl font-semibold mb-2 text-accent">{data.title}</h2>
                  <p class="text-sm text-neutral-500 dark:text-neutral-400">
                    Published: {data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}
                  </p>
                  <p class="mt-3 text-neutral-700 dark:text-neutral-300">{data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="text-center py-10 text-neutral-600 dark:text-neutral-400 space-y-4">
            <p>No posts yet. The first one is in the works.</p>
            <p>
              In the meantime, see what I've been building on the
              <a href="/projects" class="text-accent font-semibold hover:underline hover:text-highlight">Projects</a>
              page, or follow the <a href="/rss.xml" class="text-accent font-semibold hover:underline hover:text-highlight">RSS feed</a>
              to catch new posts.
            </p>
          </div>
        )}
      </section>
    </div>
  </div>

  <Footer />
</MainLayout>
