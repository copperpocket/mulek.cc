---
// src/pages/index.astro

import MainLayout from "@/layouts/MainLayout.astro";
import Starfield from "@/components/Starfield.astro";
import ThemeIcon from "@/components/Theme.astro";
import HamburgerMenu from "@/components/HamburgerMenu.astro";
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import AboutSummary from "@/components/AboutSummary.astro";
import "@/styles/global.css";

// Hero panels: a 12px edge that follows the sun's gradient (.panel-edge-sun) and fades out into the
// panel itself near the bottom, like light falling off. The corners are 6px rounder than the edge is
// thick, so the inside of the edge stays rounded.
const panel = "rounded-[1.125rem] bg-body dark:bg-body-dark border border-neutral-300 dark:border-neutral-800 panel-edge panel-edge-sun [--edge-width:12px] [--edge-fade-to:var(--edge-panel)]";
const params = import.meta.env.DEV ? Astro.url.searchParams : new URLSearchParams();

// TEMPORARY: sky options, picked with ?constellations=<n>&haze=<on|off>&nebulas=<n> on the dev server only
const skyCounts = ["2", "3", "4", "5", "6"];
const pickSky = (name: string, options: string[], fallback: string) => {
  const value = params.get(name);
  return value && options.includes(value) ? value : fallback;
};
const constellationCount = pickSky("constellations", skyCounts, "2");
const hazeSetting = pickSky("haze", ["on", "off"], "on");
const nebulaCount = pickSky("nebulas", skyCounts, "2");
const sky = { constellations: constellationCount, haze: hazeSetting, nebulas: nebulaCount };

---

<script type="module">
  import "/scripts/menu-toggle.js";
</script>

<script is:inline>
  const getTheme = () => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };

  const theme = getTheme();
  if (theme === 'light') {
    document.documentElement.classList.remove('dark');
  } else {
    document.documentElement.classList.add('dark');
  }
</script>

<MainLayout title="mulek.cc - Home" description="Michael Scott Mulek, Systems Engineer. Projects and write-ups on homelab infrastructure, self-hosting, and development.">
  <TwSizeIndicator />

  {import.meta.env.DEV && (
    <div class="fixed bottom-20 left-4 z-70 flex flex-col items-start gap-2 text-xs text-white">
      {[
        { label: "Constellations", param: "constellations", options: skyCounts, current: constellationCount },
        { label: "Haze", param: "haze", options: ["on", "off"], current: hazeSetting },
        { label: "Nebulas", param: "nebulas", options: skyCounts, current: nebulaCount },
      ].map(({ label, param, options, current }) => (
        <nav class="flex items-center gap-1 p-1 rounded-full bg-neutral-800/90 shadow-lg" aria-label={`${label} (dev only)`}>
          <span class="px-2 text-white/60">{label}</span>
          {options.map((name) => {
            const next = new URLSearchParams({ ...sky, [param]: name });
            return <a href={`/?${next}`} class:list={["px-3 py-1 rounded-full", name === current ? "bg-white text-neutral-900" : "hover:bg-white/20"]}>{name}</a>;
          })}
        </nav>
      ))}
    </div>
  )}

  <div class="relative w-full overflow-hidden min-h-screen md:h-[calc(100vh-3rem)]">

    <div class="fixed top-4 left-0 w-full z-60 px-4 sm:px-12 pointer-events-none">
      <div class="flex justify-end items-center w-full pointer-events-auto">
        
        <div data-starfield-avoid class="p-2 rounded-full">
          <ThemeIcon />
        </div>

        <div id="menu-wrapper" data-starfield-avoid class="inline-flex items-center p-2 rounded-full">
          <HamburgerMenu /> 
        </div>
        
      </div>
    </div>

    <section
      id="hero-section"
      class="absolute inset-0 flex flex-col justify-center bg-body dark:bg-body-dark"
    >
      <Starfield grid sun constellations={Number(constellationCount)} haze={hazeSetting === "on"} nebulas={Number(nebulaCount)} fixed={false} density={1.6} />

      <!-- Phones only: the sky above the horizon is left open so the whole sun shows, and the panel
           sits on the floor below it, where thumbs reach. If the screen is too short for that,
           this spacer shrinks (down to the menu's height) before the panel would be cut off. -->
      <div class="sm:hidden basis-[50vh] min-h-20" aria-hidden="true"></div>

      <div class="relative z-20 w-full px-6 sm:px-16 flex justify-center max-sm:flex-1 max-sm:items-center">
        <!-- Each column sits in its own panel, sized to its content, so stars never pass behind the text
             and the background stays the main feature. They stack below lg. Above that they sit in two
             equal halves at the same width, hugging the middle, so the gap between them lines up with the
             sun and the sun shows equally past both. -->
        <div class="flex flex-col lg:grid lg:grid-cols-2 lg:w-full items-stretch gap-6 lg:gap-12">

          <!-- Left Column: Hero Info -->
          <div data-starfield-avoid data-sun-edge class={`${panel} lg:justify-self-end lg:w-full lg:max-w-lg flex flex-col justify-center p-5 sm:p-8 text-neutral-800 dark:text-neutral-200`}>
            <div class="flex flex-col space-y-3 w-fit text-left">
              <h1 class="text-4xl lg:text-5xl font-bold">Michael Mulek</h1>
              <p class="text-lg lg:text-xl font-medium">Systems Engineer</p>
              <p class="text-base lg:text-lg text-pretty">Learn a bit about who I am and the work I’ve done.</p>

              <div class="flex flex-row space-x-3 sm:space-x-4 mt-4">
                <a href="/about" class="px-4 py-2 sm:px-6 sm:py-3 bg-accent text-on-accent font-semibold rounded-lg hover:bg-highlight transition">
                  About Me
                </a>
                <a href="/projects" class="px-4 py-2 sm:px-6 sm:py-3 border border-accent bg-body dark:bg-body-dark text-accent font-semibold rounded-lg hover:bg-highlight/10 hover:text-highlight hover:border-highlight transition">
                  My Projects
                </a>
              </div>
            </div>
          </div>

          <!-- Right Column: About Summary -->
          <div data-starfield-avoid data-sun-edge class={`${panel} lg:justify-self-start lg:w-full hidden sm:flex flex-col max-w-lg p-6 sm:p-8 text-left text-neutral-800 dark:text-neutral-200`}>
            <AboutSummary short={true} />
          </div>

        </div>
      </div>
    </section>
  </div>

  <div
    id="hidden-menu"
    class="hidden-menu fixed inset-0 bg-neutral-100/60 dark:bg-neutral-900/60 backdrop-blur-sm
          flex flex-col items-center justify-center overflow-auto z-50"
  >
    <ul class="flex flex-col p-4 space-y-6 text-neutral-800 dark:text-neutral-200 text-3xl font-bold text-center">
      <li><a href="/" class="hover:text-highlight transition">Home</a></li>
      <li><a href="/about" class="hover:text-highlight transition">About</a></li>
      <li><a href="/projects" class="hover:text-highlight transition">Projects</a></li>
      <li><a href="/blog" class="hover:text-highlight transition">Blog</a></li>
      <li><a href="/contact" class="hover:text-highlight transition">Contact</a></li>
    </ul>

  </div>
</div>

</MainLayout>

<script>
  function checkBirthdays() {
    const today = new Date();
    const currentMonthDay = `${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
    
    const birthdaySpans = document.querySelectorAll('[data-bday]');
    
    birthdaySpans.forEach(span => {
      // Clear previous content to avoid double emojis if the event fires twice
      span.textContent = ''; 
      
      if (span.getAttribute('data-bday') === currentMonthDay) {
        span.textContent = ' 🎂';
        span.classList.add('animate-bounce', 'inline-block');
      }
    });
  }

  // Listen for Astro's page load event to handle View Transitions
  document.addEventListener('astro:page-load', () => {
    checkBirthdays();
  });
</script>