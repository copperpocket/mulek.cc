---
import { ClientRouter } from "astro:transitions";
import Starfield from "@/components/Starfield.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { pageSky } from "@/config/sky";
import "@/styles/global.css";

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  /** Link preview image, as a path under public/ */
  image?: string;
  /** "article" for blog posts and project write-ups */
  type?: "website" | "article";
  /** Keep the page out of search results (the 404 page) */
  noindex?: boolean;
  /** The shared shell: the sky, the header and the footer around the page. The home page turns it off
   *  and brings its own (a bigger sky with the sun, and a menu instead of a header). */
  shell?: boolean;
}

const {
  title = "mulek.cc",
  description = "Personal website of Michael Mulek",
  image = "/og.png",
  type = "website",
  noindex = false,
  shell = true,
} = Astro.props;

// Built pages have a trailing slash in their path (/about/); the canonical URL and the sitemap don't
const canonicalUrl = new URL(Astro.url.pathname.replace(/(.)\/$/, "$1"), Astro.site);
const imageUrl = new URL(image, Astro.site);
// The default card is 1200x630; other images don't get size or alt hints
const isDefaultImage = image === "/og.png";
---

<!doctype html>
<html lang="en" class="h-full dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="alternate" type="application/rss+xml" title="mulek.cc" href="/rss.xml" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />
        {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}

        <meta property="og:type" content={type} />
        <meta property="og:site_name" content="mulek.cc" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={imageUrl} />
        {isDefaultImage && <meta property="og:image:width" content="1200" />}
        {isDefaultImage && <meta property="og:image:height" content="630" />}
        {isDefaultImage && <meta property="og:image:alt" content="Michael Mulek, Systems Engineer, mulek.cc" />}
        <meta name="twitter:card" content="summary_large_image" />
        <!-- The theme, set in this one place: localStorage.theme ("light" or "dark"), or else the system
             setting. It runs before the page paints, so it never flashes the wrong theme, and again after
             each page transition, since the new page's <html> arrives with the default class. -->
        <script is:inline>
          (function () {
            function applyTheme() {
              let saved = null;
              try { saved = localStorage.getItem("theme"); } catch {}
              const dark = saved ? saved === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
              document.documentElement.classList.toggle("dark", dark);
            }
            applyTheme();
            if (!window.__themeSetup) {
              window.__themeSetup = true;
              document.addEventListener("astro:after-swap", applyTheme);
            }
          })();
        </script>
        <ClientRouter />
    </head>
  <body class="relative flex flex-col min-h-dvh bg-body dark:bg-body-dark text-neutral-800 dark:text-neutral-200">
      {shell && <Starfield {...pageSky} />}
      {shell && <Header />}
      <slot />
      {shell && <Footer />}
  </body>
</html>
