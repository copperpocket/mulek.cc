---
// Theme.astro: the theme toggle button. The theme itself is set in MainLayout; this only switches it.
import "@/styles/theme-toggle.css";
// Generate a random ID for each instance to prevent SVG clipPath collisions
const uniqueId = `theme-toggle-cutout-${Math.random().toString(36).substr(2, 9)}`;
---

<label class="theme-toggle theme-toggle--expand text-accent hover:text-highlight transition-colors" title="Toggle theme">
  <input type="checkbox" class="theme-toggle-input" />
  <span class="theme-toggle-sr">Toggle theme</span>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    fill="currentColor"
    class="theme-toggle__expand w-7 h-7 xtall:w-8 xtall:h-8"
    viewBox="0 0 32 32"
  >
    <clipPath id={uniqueId}> <path d="M0-11h25a1 1 0 0017 13v30H0Z" />
    </clipPath>
    <g clip-path={`url(#${uniqueId})`}> <circle cx="16" cy="16" r="8.4" />
      <path
        d="M18.3 3.2c0 1.3-1 2.3-2.3 2.3s-2.3-1-2.3-2.3S14.7.9 16 .9s2.3 1 2.3 2.3zm-4.6 25.6c0-1.3 1-2.3 2.3-2.3s2.3 1 2.3 2.3-1 2.3-2.3 2.3-2.3-1-2.3-2.3zm15.1-10.5c-1.3 0-2.3-1-2.3-2.3s1-2.3 2.3-2.3 2.3 1 2.3 2.3-1 2.3-2.3 2.3zM3.2 13.7c1.3 0 2.3 1 2.3 2.3s-1 2.3-2.3 2.3S.9 17.3.9 16s1-2.3 2.3-2.3zm5.8-7C9 7.9 7.9 9 6.7 9S4.4 8 4.4 6.7s1-2.3 2.3-2.3S9 5.4 9 6.7zm16.3 21c-1.3 0-2.3-1-2.3-2.3s1-2.3 2.3-2.3 2.3 1 2.3 2.3-1 2.3-2.3 2.3zm2.4-21c0 1.3-1 2.3-2.3 2.3S23 7.9 23 6.7s1-2.3 2.3-2.3 2.4 1 2.4 2.3zM6.7 23C8 23 9 24 9 25.3s-1 2.3-2.3 2.3-2.3-1-2.3-2.3 1-2.3 2.3-2.3z"
      />
    </g>
  </svg>
</label>

<script>
  // Every toggle on the page (there can be two: the header's and the site menu's) shows the current
  // theme and switches it, saving the choice and telling the starfield to repaint
  document.addEventListener('astro:page-load', () => {
    const toggles = document.querySelectorAll<HTMLInputElement>(".theme-toggle-input");
    const html = document.documentElement;
    const sync = () => toggles.forEach((toggle) => (toggle.checked = !html.classList.contains("dark")));
    sync();
    toggles.forEach((toggle) => {
      toggle.addEventListener("change", () => {
        const theme = toggle.checked ? "light" : "dark";
        html.classList.toggle("dark", theme === "dark");
        try { localStorage.setItem("theme", theme); } catch {}
        sync();
        document.dispatchEvent(new Event("themechange"));
      });
    });
  });
</script>
