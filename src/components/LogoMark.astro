---
// The >m_ prompt mark. Master copies of the logo files live in public/images/logo/.
// Colors come from --logo-ink and --logo-star in global.css, so it follows the site theme.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="-8.5 -10 84 84"
  role="img"
  aria-label="mulek.cc"
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    d="M0 22 L10 32 L0 42 M22 42 V28 A6 6 0 0 1 34 28 V42 M34 28 A6 6 0 0 1 46 28 V42"
    fill="none"
    stroke="var(--logo-ink)"
    stroke-width="5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <rect x="55.5" y="39.5" width="14" height="5" rx="1.2" fill="var(--logo-star)" />
</svg>
