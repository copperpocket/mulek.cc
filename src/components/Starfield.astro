---
// Starfield.astro - twinkling stars and the occasional comet drawn on a single
// canvas, with an optional scrolling synthwave grid below a horizon line. Colors come from the
// --starfield-* variables in global.css and follow the theme toggle.
interface Props {
  /** Stars per 100x100px of sky */
  density?: number;
  /** Draw the perspective grid below the horizon; stars stay above it */
  grid?: boolean;
  /** Horizon height as a fraction of the canvas (only used with grid) */
  horizon?: number;
  /** Pin to the viewport, or fill the nearest positioned parent */
  fixed?: boolean;
}

const { density = 1, grid = false, horizon = 0.5, fixed = true } = Astro.props;
---

<canvas
  class:list={["starfield inset-0 w-full h-full pointer-events-none z-10", fixed ? "fixed" : "absolute"]}
  data-density={density}
  data-grid={grid ? "" : undefined}
  data-horizon={horizon}
  aria-hidden="true"
></canvas>

<script>
  type StarColor = "star" | "alt" | "red" | "blue";

  interface Star {
    x: number; // 0-1 across the sky
    y: number; // 0-1 down the sky
    r: number;
    minAlpha: number;
    maxAlpha: number;
    period: number; // seconds per twinkle
    phase: number;
    color: StarColor;
    jitter: number; // px of drift, 0 for most stars
    jitterPeriod: number;
    jitterPhase: number;
  }

  interface Comet {
    x: number; // starting point, px
    y: number;
    vx: number; // px per second
    vy: number;
    born: number; // ms timestamp
    life: number; // seconds
    size: number; // 0-1: small, faint and short up to big, bright and long
    glow: StarColor;
  }

  const TAU = Math.PI * 2;

  // Grid shape, tuned to match the original SVG
  const GRID_ROW_RATIO = 0.67; // each row sits this fraction as far from the horizon as the one in front
  const GRID_ROWS = 14;
  const GRID_ROW_SECONDS = 1; // time for a row to move into the next one's place
  const GRID_COLUMNS = 10; // per side of the center line
  const GRID_FAR_GAP = 0.0484; // column spacing at the horizon, as a fraction of the grid span
  const GRID_NEAR_GAP = 0.2373; // column spacing at the bottom edge

  // Rare colored stars, as a fraction of all stars
  const RED_STAR_CHANCE = 0.02;
  const BLUE_STAR_CHANCE = 0.02;
  const ALT_STAR_CHANCE = 0.3; // neutral white/black instead of the accent

  // Comets: a faint streak every so often, never more than one at a time
  const COMET_FIRST_SECONDS = [8, 30]; // delay before the first one
  const COMET_GAP_SECONDS = [20, 50]; // delay between comets
  const COMET_LIFE_SECONDS = [1.2, 2];
  const COMET_SPEED = [180, 330]; // px per second
  const COMET_ANGLE_DEGREES = [10, 45]; // below horizontal
  const COMET_RED_GLOW_CHANCE = 0.1; // otherwise an even split of accent and blue
  // These scale with each comet's size, from smallest to biggest
  const COMET_TAIL_SECONDS = [0.27, 0.75]; // tail length, as time travelled
  const COMET_TAIL_WIDTH = [0.9, 1.8]; // px at the head
  const COMET_HEAD_RADIUS = [0.9, 1.8];
  const COMET_GLOW_BLUR = [6, 14];
  const COMET_MAX_ALPHA = [0.4, 0.7];

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let stopAll: (() => void)[] = [];

  const rand = (min: number, max: number) => Math.random() * (max - min) + min;
  const randIn = ([min, max]: number[]) => rand(min, max);
  const lerp = ([min, max]: number[], t: number) => min + (max - min) * t;

  function pickStarColor(): StarColor {
    const roll = Math.random();
    if (roll < RED_STAR_CHANCE) return "red";
    if (roll < RED_STAR_CHANCE + BLUE_STAR_CHANCE) return "blue";
    if (roll < RED_STAR_CHANCE + BLUE_STAR_CHANCE + ALT_STAR_CHANCE) return "alt";
    return "star";
  }

  function makeStar(): Star {
    const period = rand(4, 10);
    return {
      x: Math.random(),
      y: Math.random(),
      r: rand(1, 2.5),
      minAlpha: rand(0, 0.15),
      maxAlpha: rand(0.15, 0.5),
      period,
      phase: Math.random() * TAU,
      color: pickStarColor(),
      jitter: Math.random() < 0.35 ? rand(2, 5) : 0,
      jitterPeriod: period * 2,
      jitterPhase: Math.random() * TAU,
    };
  }

  // Resolve a CSS variable to a color the canvas understands
  function readColor(canvas: HTMLCanvasElement, name: string) {
    canvas.style.color = `var(${name})`;
    return getComputedStyle(canvas).color;
  }

  function start(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return () => {};

    const density = Number(canvas.dataset.density) || 1;
    const hasGrid = canvas.dataset.grid !== undefined;
    const horizon = hasGrid ? Number(canvas.dataset.horizon) || 0.5 : 1;

    let width = 0;
    let height = 0;
    let frame = 0;
    const stars: Star[] = [];
    const colors = { star: "", alt: "", red: "", blue: "", grid: "" };
    let comet: Comet | null = null;
    let nextCometAt = performance.now() + randIn(COMET_FIRST_SECONDS) * 1000;

    function readColors() {
      colors.star = readColor(canvas, "--starfield-star");
      colors.alt = readColor(canvas, "--starfield-star-alt");
      colors.red = readColor(canvas, "--starfield-star-red");
      colors.blue = readColor(canvas, "--starfield-star-blue");
      colors.grid = readColor(canvas, "--starfield-grid");
    }

    function resize() {
      const dpr = window.devicePixelRatio || 1;
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Stars are stored in relative coordinates, so a resize (like a mobile
      // URL bar collapsing) keeps them in place and only tops up or trims the count
      const target = Math.round(((width * height * horizon) / 10000) * density);
      while (stars.length < target) stars.push(makeStar());
      stars.length = target;
    }

    function drawGrid(t: number) {
      const top = height * horizon;
      const floor = height - top;
      // Size the grid as if the screen were at least 4:3, so narrow screens
      // crop the sides instead of squeezing the columns together
      const span = Math.max(width, height * (4 / 3));
      const cx = width / 2;

      ctx!.strokeStyle = colors.grid;
      ctx!.lineWidth = 1;
      ctx!.globalAlpha = 1;

      ctx!.beginPath();
      ctx!.moveTo(0, top);
      ctx!.lineTo(width, top);
      for (let i = -GRID_COLUMNS; i <= GRID_COLUMNS; i++) {
        ctx!.moveTo(cx + i * span * GRID_FAR_GAP, top);
        ctx!.lineTo(cx + i * span * GRID_NEAR_GAP, height);
      }
      ctx!.stroke();

      // Rows are spaced geometrically and slide toward the viewer
      const progress = (t / 1000 / GRID_ROW_SECONDS) % 1;
      for (let n = 0; n < GRID_ROWS; n++) {
        const depth = Math.pow(GRID_ROW_RATIO, n - progress);
        if (depth > 1.1) continue;
        const y = top + floor * depth;
        ctx!.globalAlpha = Math.min(1, depth / 0.03); // fade in at the horizon
        ctx!.beginPath();
        ctx!.moveTo(0, y);
        ctx!.lineTo(width, y);
        ctx!.stroke();
      }
      ctx!.globalAlpha = 1;
    }

    function drawStars(t: number) {
      const sky = height * horizon;
      const seconds = t / 1000;
      for (const s of stars) {
        const twinkle = 0.5 + 0.5 * Math.cos((TAU * seconds) / s.period + s.phase);
        let x = s.x * width;
        let y = s.y * sky;
        if (s.jitter) {
          const a = (TAU * seconds) / s.jitterPeriod + s.jitterPhase;
          x += s.jitter * Math.sin(a);
          y += s.jitter * Math.sin(a * 1.3 + 1);
        }
        ctx!.globalAlpha = s.minAlpha + (s.maxAlpha - s.minAlpha) * twinkle;
        ctx!.fillStyle = colors[s.color];
        ctx!.beginPath();
        ctx!.arc(x, y, s.r, 0, TAU);
        ctx!.fill();
      }
      ctx!.globalAlpha = 1;
    }

    function pickCometGlow(): StarColor {
      if (Math.random() < COMET_RED_GLOW_CHANCE) return "red";
      return Math.random() < 0.5 ? "star" : "blue";
    }

    function spawnComet(now: number) {
      const sky = height * horizon;
      const speed = randIn(COMET_SPEED);
      const angle = (randIn(COMET_ANGLE_DEGREES) * Math.PI) / 180;
      const direction = Math.random() < 0.5 ? 1 : -1;
      comet = {
        x: rand(0.1, 0.9) * width,
        y: rand(0, 0.5) * sky,
        vx: Math.cos(angle) * speed * direction,
        vy: Math.sin(angle) * speed,
        born: now,
        life: randIn(COMET_LIFE_SECONDS),
        size: Math.random() ** 1.5, // skewed small, so big ones are rarer
        glow: pickCometGlow(),
      };
    }

    function drawComet(c: Comet, now: number) {
      const age = (now - c.born) / 1000;
      const progress = age / c.life;
      if (progress >= 1) {
        comet = null;
        return;
      }

      // Quick fade in, long fade out
      const fade = Math.min(1, progress / 0.15) * Math.min(1, (1 - progress) / 0.5) * lerp(COMET_MAX_ALPHA, c.size);
      const headX = c.x + c.vx * age;
      const headY = c.y + c.vy * age;
      const tail = Math.min(lerp(COMET_TAIL_SECONDS, c.size), age); // don't trail back past where it appeared
      const tailWidth = lerp(COMET_TAIL_WIDTH, c.size);

      ctx!.save();
      // Keep it in the sky, above the grid
      ctx!.beginPath();
      ctx!.rect(0, 0, width, height * horizon);
      ctx!.clip();

      // Tail: short segments that thin out and fade away from the head
      const segments = 12;
      ctx!.strokeStyle = colors.alt;
      ctx!.lineCap = "round";
      for (let i = 0; i < segments; i++) {
        const from = i / segments;
        const to = (i + 1) / segments;
        ctx!.globalAlpha = fade * (1 - from) * 0.6;
        ctx!.lineWidth = 0.3 + (tailWidth - 0.3) * (1 - from);
        ctx!.beginPath();
        ctx!.moveTo(headX - c.vx * tail * from, headY - c.vy * tail * from);
        ctx!.lineTo(headX - c.vx * tail * to, headY - c.vy * tail * to);
        ctx!.stroke();
      }

      // Head with a soft colored glow
      ctx!.globalAlpha = fade;
      ctx!.shadowColor = colors[c.glow];
      ctx!.shadowBlur = lerp(COMET_GLOW_BLUR, c.size);
      ctx!.fillStyle = colors.alt;
      ctx!.beginPath();
      ctx!.arc(headX, headY, lerp(COMET_HEAD_RADIUS, c.size), 0, TAU);
      ctx!.fill();
      ctx!.restore();
    }

    function draw(t: number) {
      ctx!.clearRect(0, 0, width, height);
      if (hasGrid) drawGrid(t);
      drawStars(t);
      if (comet) drawComet(comet, t);
    }

    function loop(now: number) {
      if (!comet && now >= nextCometAt) {
        spawnComet(now);
        nextCometAt = now + randIn(COMET_GAP_SECONDS) * 1000;
      }
      draw(now);
      frame = requestAnimationFrame(loop);
    }

    // With reduced motion, draw a single still frame and redraw only when something changes
    const redrawIfStill = () => reducedMotion.matches && draw(0);

    const observer = new ResizeObserver(() => {
      resize();
      redrawIfStill();
    });
    const onThemeChange = () => {
      readColors();
      redrawIfStill();
    };

    readColors();
    resize();
    observer.observe(canvas);
    document.addEventListener("themechange", onThemeChange);
    if (reducedMotion.matches) draw(0);
    else frame = requestAnimationFrame(loop);

    return () => {
      cancelAnimationFrame(frame);
      observer.disconnect();
      document.removeEventListener("themechange", onThemeChange);
    };
  }

  function init() {
    stopAll.forEach((stop) => stop());
    stopAll = [...document.querySelectorAll<HTMLCanvasElement>("canvas.starfield")].map(start);
  }

  // Runs on first load and after every view transition
  document.addEventListener("astro:page-load", init);
  reducedMotion.addEventListener("change", init);
</script>
