---
import ThemeIcon from "./Theme.astro";
import HamburgerMenu from "./HamburgerMenu.astro";
import Wordmark from "./Wordmark.astro";

interface Props {
  hideLogo?: boolean;
  navBreakpoint?: 'md' | 'lg';
  
}

const { hideLogo = false, navBreakpoint = 'md' } = Astro.props;

// Map the prop to the full class string
const breakpointClasses = {
  md: 'md:flex',
  lg: 'lg:flex',
};

// Use the mapped value
const displayClass = breakpointClasses[navBreakpoint];

const pathname = Astro.url.pathname;
const isActive = (path: string) => 
  pathname === path || (path !== '/' && pathname.startsWith(path));
---

<!--
  Fixed header with two states, switched by data-scrolled:
  - at the top of the page: taller and transparent, with larger, more spaced-out items
  - scrolled: compact, solid background, accent line underneath
  The spacer below keeps page content from sliding under the expanded header.
-->
<header id="site-header" class="site-header fixed inset-x-0 top-0 z-40" data-scrolled="false">
  <div class="header-inner relative flex items-center justify-between w-full px-10 lg:px-16">
    <span class="header-line absolute bottom-0 left-0 h-[2px] w-full bg-accent"></span>

    {hideLogo !== true && (
      <a href="/" class="header-logo flex items-center" aria-label="mulek.cc home">
        <Wordmark class="h-full w-auto" />
      </a>
    )}

    <nav class={`header-nav hidden ${displayClass} items-center absolute left-1/2 -translate-x-1/2`}>
      <a href="/" class:list={["nav-link", { "active": isActive('/') }]}>Home</a>
      <a href="/about" class:list={["nav-link", { "active": isActive('/about') }]}>About</a>
      <a href="/projects" class:list={["nav-link", { "active": isActive('/projects') }]}>Projects</a>
      <a href="/blog" class:list={["nav-link", { "active": isActive('/blog') }]}>Blog</a>
      <a href="/contact" class:list={["nav-link", { "active": isActive('/contact') }]}>Contact</a>
    </nav>

    <div class="header-actions flex items-center space-x-6">
      <div class="inline-flex items-center">
        <ThemeIcon />
      </div>
      <div class="inline-flex z-50 items-center md:hidden">
        <HamburgerMenu />
      </div>
    </div>

    <div
      id="hidden-menu"
      class="hidden-menu fixed inset-0 bg-neutral-100/60 dark:bg-neutral-900/60 backdrop-blur-sm
             flex items-center justify-center overflow-auto z-40 md:hidden"
    >
      <ul class="flex flex-col p-4 space-y-4 text-neutral-800 dark:text-neutral-200 text-2xl">
        <li><a href="/" class="hover:text-blue-500">Home</a></li>
        <li><a href="/about" class="hover:text-blue-500">About</a></li>
        <li><a href="/blog" class="hover:text-blue-500">Blog</a></li>
        <li><a href="/contact" class="hover:text-blue-500">Contact</a></li>
        <li><a href="/projects" class="hover:text-blue-500">Projects</a></li>
      </ul>
    </div>
  </div>
</header>

<div class="header-spacer" aria-hidden="true"></div>

<script>
  // Bundled scripts run once per full page load, so this listener is only ever added once,
  // even with ClientRouter page transitions. astro:page-load re-syncs the new page's header.
  const SCROLL_THRESHOLD = 24;

  function updateHeader() {
    const header = document.getElementById("site-header");
    if (header) header.dataset.scrolled = String(window.scrollY > SCROLL_THRESHOLD);
  }

  window.addEventListener("scroll", updateHeader, { passive: true });
  document.addEventListener("astro:page-load", updateHeader);
</script>

<style>
  .site-header,
  .header-inner,
  .header-logo,
  .header-nav,
  .header-actions,
  .header-line {
    transition: all 300ms ease;
  }

  /* At the top of the page */
  .header-inner { height: 5.5rem; }
  .header-spacer { height: 5.5rem; }
  .header-logo { height: 2.25rem; }
  .header-nav { gap: 2rem; font-size: 1.125rem; }
  .header-actions { transform: scale(1.15); transform-origin: right center; }
  .header-line { opacity: 0; }

  /* Scrolled */
  .site-header[data-scrolled="true"] { background-color: var(--color-body); }
  :global(html.dark) .site-header[data-scrolled="true"] { background-color: var(--color-body-dark); }
  .site-header[data-scrolled="true"] .header-inner { height: 3.75rem; }
  .site-header[data-scrolled="true"] .header-logo { height: 1.75rem; }
  .site-header[data-scrolled="true"] .header-nav { gap: 1.5rem; font-size: 1rem; }
  .site-header[data-scrolled="true"] .header-actions { transform: none; }
  .site-header[data-scrolled="true"] .header-line { opacity: 0.9; }
</style>

<script type="module">
  import "/scripts/menu-toggle.js";
</script>