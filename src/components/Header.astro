---
import ThemeIcon from "./Theme.astro";
import SiteMenu from "./SiteMenu.astro";
import Wordmark from "./Wordmark.astro";
import { navLinks, isCurrent } from "@/config/links";

interface Props {
  hideLogo?: boolean;
  navBreakpoint?: 'md' | 'lg';
  
}

const { hideLogo = false, navBreakpoint = 'md' } = Astro.props;

// Map the prop to the full class string
const breakpointClasses = {
  md: 'md:flex',
  lg: 'lg:flex',
};

// Use the mapped value
const displayClass = breakpointClasses[navBreakpoint];

const pathname = Astro.url.pathname;
---

<!--
  Fixed header with two states, switched by data-scrolled:
  - at the top of the page: taller and transparent, with larger, more spaced-out items
  - scrolled: compact, solid background, accent line underneath
  The spacer below keeps page content from sliding under the expanded header.
-->
<header id="site-header" class="site-header fixed inset-x-0 top-0 z-40" data-scrolled="false" data-starfield-avoid="static">
  <div class="header-inner relative flex items-center justify-between w-full px-6 sm:px-14">
    <span class="header-line absolute bottom-0 left-0 h-[2px] w-full"></span>

    {hideLogo !== true && (
      <a href="/" class="header-logo flex items-center" aria-label="mulek.cc home">
        <Wordmark class="h-full w-auto" />
      </a>
    )}

    <nav class={`header-nav hidden ${displayClass} items-center absolute left-1/2 -translate-x-1/2`}>
      {navLinks.map(({ href, label }) => (
        <a href={href} class:list={["nav-link", { active: isCurrent(href, pathname) }]} aria-current={isCurrent(href, pathname) ? "page" : undefined}>{label}</a>
      ))}
    </nav>

    <div class="header-actions flex items-center -mr-2">
      <!-- On phones the theme toggle lives inside the menu -->
      <div class="hidden md:inline-flex items-center p-2 rounded-full">
        <ThemeIcon />
      </div>
      <div class="md:hidden">
        <SiteMenu />
      </div>
    </div>

  </div>
</header>

<div class="header-spacer" aria-hidden="true"></div>

<script>
  // Bundled scripts run once per full page load, so this listener is only ever added once,
  // even with ClientRouter page transitions. astro:page-load re-syncs the new page's header.
  const SCROLL_THRESHOLD = 24;

  function updateHeader() {
    const header = document.getElementById("site-header");
    if (header) header.dataset.scrolled = String(window.scrollY > SCROLL_THRESHOLD);
  }

  window.addEventListener("scroll", updateHeader, { passive: true });
  document.addEventListener("astro:page-load", updateHeader);
</script>

<style>
  .site-header,
  .header-inner,
  .header-logo,
  .header-nav,
  .header-actions,
  .header-line {
    transition: all 300ms ease;
  }

  /* At the top of the page */
  .header-inner { height: 5.5rem; }
  .header-spacer { height: 5.5rem; }
  .header-logo { height: 2.25rem; }
  .header-nav { gap: 2rem; font-size: 1.125rem; }
  /* Lavender with the sun's pink in the middle */
  .header-line {
    opacity: 0;
    background-image: linear-gradient(to right, var(--color-accent), var(--color-highlight), var(--color-accent));
  }

  /* Scrolled */
  .site-header[data-scrolled="true"] { background-color: var(--color-body); }
  :global(html.dark) .site-header[data-scrolled="true"] { background-color: var(--color-body-dark); }
  .site-header[data-scrolled="true"] .header-inner { height: 3.75rem; }
  .site-header[data-scrolled="true"] .header-logo { height: 1.75rem; }
  .site-header[data-scrolled="true"] .header-nav { gap: 1.5rem; font-size: 1rem; }
  .site-header[data-scrolled="true"] .header-line { opacity: 0.9; }
</style>